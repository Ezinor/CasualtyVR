# OpenXR SDK: keep only the headers, the x64 import library, the loader DLL and the licence.
/third_party/openxr_loader_windows-*.zip
/third_party/openxr-*/ARM64_uwp/
/third_party/openxr-*/Win32/
/third_party/openxr-*/Win32_uwp/
/third_party/openxr-*/x64_uwp/
/third_party/openxr-*/x64/bin/*
!/third_party/openxr-*/x64/bin/openxr_loader.dll

